          "stringUnit" : {
            "state" : "translated",
            "value" : "Giriş FET hataları"
          }
        }
      }
    },
    "Interface" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arayüz"
          }
        }
      }
    },
    "Interface CRC errors" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arayüz CRC hataları"
          }
        }
      }
    },
    "Internal SSD" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dahili SSD"
          }
        }
      }
    },
    "Its wear counter is not documented, so FixStat does not guess a percentage. Judge it by the erase cycles, spare blocks and errors." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aşınma sayacı belgelenmemiş, bu yüzden FixStat yüzde tahmin etmiyor. Silme döngülerine, yedek bloklara ve hatalara bakarak değerlendirin."
          }
        }
      }
    },
    "I²C errors" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I²C hataları"
          }
        }
      }
    },
    "JSON…" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JSON…"
          }
        }
      }
    },
    "Keep a finger resting on the trackpad: three taps should be felt." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir parmağınız trackpad üzerinde dursun: üç tık hissedilmeli."
          }
        }
      }
    },
    "Keep network connections (TCP keepalive)" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağ bağlantılarını koru (TCP keepalive)"
          }
        }
      }
    },
    "Keep the Mac awake" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac'i uyanık tutanlar"
          }
        }
      }
    },
    "Keep the sensor uncovered in normal room light…" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensörü normal oda ışığında açık bırakın…"
          }
        }
      }
    },
    "Kernel panics" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kernel panic'ler"
          }
        }
      }
    },
    "Kernel panics (30 days)" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kernel panic (30 gün)"
          }
        }
      }
    },
    "Key" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anahtar"
          }
        }
      }
    },
