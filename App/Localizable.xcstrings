          "stringUnit" : {
            "state" : "translated",
            "value" : "Boşta uyku"
          }
        }
      }
    },
    "Input" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giriş"
          }
        }
      }
    },
    "Input FET failures" : {
