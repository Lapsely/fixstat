    "Very low cycle count despite long operating time (reset or new pack?)" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzun çalışma süresine rağmen çok düşük döngü sayısı (sıfırlanmış veya yeni paket?)"
          }
        }
      }
    },
    "Video decoder (AVD)" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video çözücü (AVD)"
          }
