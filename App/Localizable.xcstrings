      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağ erişimi için uyan"
          }
        }
      }
    },
    "Wake reasons" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
