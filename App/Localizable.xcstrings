            "value" : "Adres = veri"
          }
        }
      }
    },
    "Adds a numbered marker (M1, M2 …) to the charts and the CSV, e.g. when you plug in the charger." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grafiklere ve CSV'ye numaralı bir işaret (M1, M2 …) ekler; örneğin şarj aletini taktığınız an."
          }
        }
      }
    },
    "Administrator permission was not given." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yönetici izni verilmedi."
          }
        }
      }
    },
    "Airflow temperature" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
