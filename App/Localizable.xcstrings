            "value" : "Sabit disk"
          }
        }
      }
    },
    "Hard resets" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hard reset"
          }
        }
      }
    },
    "Hardly moved under load while the other sensors of its group heated up: stuck or badly placed sensor." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grubundaki diğer sensörler ısınırken yük altında neredeyse hiç değişmedi: takılı ya da yerinden oynamış sensör."
          }
        }
      }
    },
    "Hardware check" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donanım kontrolü"
          }
        }
      }
    },
