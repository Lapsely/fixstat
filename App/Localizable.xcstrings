      }
    },
    "Grown bad blocks" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonradan oluşan bozuk bloklar"
          }
        }
      }
    },
    "Half of the CPU cores busy — like heavy multitasking or photo editing." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU çekirdeklerinin yarısı dolu — yoğun çoklu iş veya fotoğraf düzenleme gibi."
          }
        }
      }
    },
    "Haptic feedback" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titreşim (haptik)"
          }
        }
      }
