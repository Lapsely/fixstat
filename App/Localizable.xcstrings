        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem %2$@ istediği halde fan %1$lld dönmüyor: konnektörü ve fanı kontrol edin."
          }
        }
      }
    },
    "Fan %lld stays well below its target (%@ instead of %@): worn bearing, dirt or a weak fan." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fan %1$lld stays well below its target (%2$@ instead of %3$@): worn bearing, dirt or a weak fan."
