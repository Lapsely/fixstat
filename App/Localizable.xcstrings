      }
    },
    "Resistance" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direnç"
          }
        }
      }
    },
    "Resistance is the gauge's weighted cell resistance; its unit is not documented, compare the cells with each other." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direnç, gauge'un ağırlıklı hücre direncidir; birimi belgelenmemiştir, hücreleri birbiriyle karşılaştırın."
          }
        }
      }
