        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fan %1$lld hedefinin çok altında kalıyor (%3$@ yerine %2$@): aşınmış rulman, kir veya zayıf fan."
          }
        }
      }
