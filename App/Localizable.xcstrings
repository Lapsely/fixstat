    "Spare NAND blocks the SSD still has to replace worn-out ones. It starts at 100 % and drops as blocks fail; a low value means the drive is running out of replacements." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSD'nin aşınan blokların yerine koyabileceği yedek NAND blokları. %100'den başlar, bloklar bozuldukça düşer; düşük değer diskin yedeklerinin tükendiğini gösterir."
          }
        }
      }
    },
    "Spare blocks below threshold (%lld %%)." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yedek bloklar eşiğin altında (%%%lld)."
