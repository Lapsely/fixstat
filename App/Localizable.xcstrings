    "Settings…" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar…"
          }
        }
      }
    },
    "Share of the pack's life it spent at a high charge, counted by the gauge. Sitting near full all the time ages the cells faster; a Mac that lives on the adapter shows a high share." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paketin ömrünün yüksek şarjda geçen kısmı (gauge sayar). Sürekli doluya yakın durmak hücreleri daha hızlı yaşlandırır; hep adaptörde duran bir Mac'te bu oran yüksektir."
          }
        }
      }
    },
    "Shine a phone flashlight at the sensor next to the camera." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameranın yanındaki sensöre telefon feneri tutun."
          }
        }
      }
    },
