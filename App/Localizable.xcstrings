          "stringUnit" : {
            "state" : "translated",
            "value" : "Değer"
          }
        }
      }
    },
    "Values as the SMC reports them, a few times a second: slow changes show, microsecond dips and ripple do not (that needs an oscilloscope)." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Değerler SMC'nin bildirdiği gibi, saniyede birkaç kez: yavaş değişimler görünür, mikrosaniyelik düşüşler ve dalgalanma görünmez (onun için osiloskop gerekir)."
          }
        }
      }
    },
    "Vendor specific" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üreticiye özel"
          }
        }
      }
